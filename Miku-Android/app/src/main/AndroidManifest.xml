<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake-word "Hey Miku" (wakeword/WakeWordService.kt): escucha
         continua en primer plano, equivalente a la Tarea 5.4 de desktop. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Sin este permiso, ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS no
         muestra el diálogo del sistema (el botón "Evitar que el sistema
         corte el micrófono" quedaba sin hacer nada). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Necesario para que la notificación de pantalla completa lance
         MikuOverlayActivity de inmediato al decir "Hey Miku" (en vez de
         quedar solo como una notificación normal que hay que tocar),
         ver wakeword/MikuOverlayActivity.kt. Camino de RESPALDO nada más:
         Android solo la abre sola con la pantalla bloqueada, es
         política de la plataforma, no algo que este permiso solucione
         del todo (ver wakeword/MikuOverlayWindow.kt, el camino principal). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Permiso de "Mostrar sobre otras apps": el camino PRINCIPAL para
         la pantalla flotante (wakeword/MikuOverlayWindow.kt): aparece al
         instante sin pasar por notificaciones, sin importar si la
         pantalla está bloqueada o en uso. Hay que darlo a mano desde
         Configuración (no se puede pedir con un diálogo normal). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".MikuApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Miku"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MikuAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Redirect de OAuth de Spotify (ver SpotifyAuth.kt): este
                 esquema tiene que coincidir exacto con el Redirect URI
                 registrado en el dashboard de Spotify. singleTask arriba
                 asegura que vuelva a la MISMA instancia de la app en vez
                 de crear una nueva (ver onNewIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mikuai" android:host="spotify-callback" />
            </intent-filter>
        </activity>

        <receiver
            android:name="androidx.work.impl.utils.ForceStopRunnable$BroadcastReceiver"
            android:exported="false" />

        <!-- Relanza "Hey Miku" tras reiniciar el teléfono, si estaba
             activado (ver wakeword/BootReceiver.kt). -->
        <receiver
            android:name=".wakeword.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Pantalla flotante estilo "Hey Gemini" al decir "Hey Miku"
             (ver wakeword/MikuOverlayActivity.kt). taskAffinity vacío +
             excludeFromRecents: que no aparezca en Recientes ni se mezcle
             con la tarea de MainActivity. singleTask: si ya está abierta,
             reusar esa instancia en vez de apilar otra. -->
        <activity
            android:name=".wakeword.MikuOverlayActivity"
            android:exported="false"
            android:theme="@style/Theme.MikuOverlay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:noHistory="true" />

        <!-- Ficha de Ajustes Rápidos para prender/apagar "Hey Miku"
             (ver wakeword/WakeWordTileService.kt). -->
        <service
            android:name=".wakeword.WakeWordTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="Hey Miku"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>